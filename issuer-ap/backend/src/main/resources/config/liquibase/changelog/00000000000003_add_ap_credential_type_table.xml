<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="00000000000003-1" author="issuer-ap">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ap_credential_type" schemaName="issuer_ap"/>
            </not>
        </preConditions>

        <createSequence sequenceName="ap_credential_type_id_seq" schemaName="issuer_ap"
                        startValue="1" incrementBy="1"/>

        <createTable tableName="ap_credential_type" schemaName="issuer_ap">
            <column name="id" type="BIGINT" defaultValueSequenceNext="ap_credential_type_id_seq">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="credential_type" type="VARCHAR(200)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="ux_ap_credential_type_credential_type"/>
            </column>
            <column name="business_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="schema_id" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="vc_schema" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="effective_time_unit" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_time_value" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="metadata" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="enable_tx_code" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="enable_vc_transfer" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
